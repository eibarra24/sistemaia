{
  "name": "sistema-ia-gastos",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de administración de gastos personales con alertas",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start --workspace=apps/api"
  },
  "engines": {
    "node": ">=18"
  }
}
